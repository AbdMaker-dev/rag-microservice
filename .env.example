# --- Identity -----------------------------------------------------------------
SERVICE_NAME=rag-microservice
ENVIRONMENT=development
DATA_CLASSIFICATION=SYNTHETIC_ONLY

# --- Service-to-service authentication ----------------------------------------
# 32 characters minimum. The LawalSchool API sends it as X-Service-Token.
# Generate with: openssl rand -hex 32
SERVICE_SHARED_SECRET=local-development-shared-secret-change-before-staging

# --- Base d'index du service (sa propre base, pas celle de LawalSchool) ---
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# --- Database ------------------------------------------------------------------
# Utilisé hors conteneur (scripts, tests). Dans Docker, le compose impose
# postgres:5432 : les services se joignent par leur nom.
DATABASE_URL=postgresql://rag:change-me@localhost:25432/ragdb
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=8
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Inference -----------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5vl:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=
INFERENCE_TIMEOUT_S=30
INFERENCE_MAX_ATTEMPTS=3

# --- Chunking ------------------------------------------------------------------
CHUNK_MAX_TOKENS=384
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32

# --- Retrieval -----------------------------------------------------------------
RETRIEVAL_CANDIDATES=24
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_EXCERPT_CHARACTERS=1200
RERANKER_ENABLED=false
RERANKER_MODEL=

# --- Ingestion -----------------------------------------------------------------
MAX_DOCUMENT_BYTES=25000000

# --- Lecture de pages par vision ---------------------------------------------
# Le même modèle que la génération relit les pages sans couche texte, ou dont
# les polices sont mal déclarées et rendent le texte illisible.
VISION_ENABLED=true
VISION_MODEL=qwen2.5vl:7b
VISION_TIMEOUT_S=300
VISION_RENDER_SCALE=1.5
VISION_CONTEXT_TOKENS=16384
VISION_MAX_OUTPUT_TOKENS=4096
VISION_MAX_PAGES=120
VISION_QUALITY_THRESHOLD=0.80

# --- Observability -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_REDACTION_ENABLED=true
